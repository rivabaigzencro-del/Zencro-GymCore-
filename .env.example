# ==========================================
# GymCore Backend Environment Configuration
# Copy this file to .env and adjust values as needed
# ==========================================

# Application Settings
PROJECT_NAME="GymCore API"
ENV="development"
DEBUG=True
API_V1_STR="/api/v1"

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Configuration (JSON array or comma-separated list of allowed origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# Database Configuration (PostgreSQL / Supabase)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/gymcore_db"

# JWT & Authentication Configuration (Placeholder for auth module)
# Generate a strong key using: openssl rand -hex 32
SECRET_KEY="change-this-in-production-to-a-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
